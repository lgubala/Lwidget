<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ALARM_LISTENER" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="org.tasks.permission.READ_TASKS" />
    <uses-permission android:name="com.todoroo.astrid.READ" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    
    <!-- Breezy Weather Local Data Sharing Permission -->
    <uses-permission android:name="org.breezyweather.READ_PROVIDER" />

    <!-- Health Connect: where Garmin Connect and friends publish their figures -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />

    <!-- Required for Android 11+ (API 30) to see these packages -->
    <queries>
        <!-- Weather Apps -->
        <package android:name="org.breezyweather" />
        
        <!-- Clock Apps -->
        <package android:name="com.android.deskclock" />
        <package android:name="com.google.android.deskclock" />
        <package android:name="com.simplemobiletools.clock" />
        <package android:name="org.fossify.clock" />
        
        <!-- Calendar Apps -->
        <package android:name="com.android.calendar" />
        <package android:name="com.google.android.calendar" />
        <package android:name="com.simplemobiletools.calendar" />
        <package android:name="org.fossify.calendar" />
        
        <!-- Task Apps -->
        <package android:name="org.tasks" />

        <!-- Health Connect (a separate app before Android 14, part of the platform after) -->
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CALENDAR" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <!-- Search widget -->
        <intent>
            <action android:name="android.search.action.GLOBAL_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.speech.action.VOICE_SEARCH_HANDS_FREE" />
        </intent>
        <intent>
            <action android:name="android.speech.action.WEB_SEARCH" />
        </intent>
        <package android:name="com.samsung.android.calendar" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Lwidget">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Lwidget">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Health Connect requires a screen explaining why the data is read -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:theme="@style/Theme.Lwidget" />

        <receiver android:name=".AwidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.CONFIGURATION_CHANGED" />
                <action android:name="com.leanbitlab.lwidget.ACTION_BATTERY_UPDATE" /> 
                <action android:name="com.leanbitlab.lwidget.ACTION_STEP_UPDATE" /> 
                <action android:name="android.app.action.NEXT_ALARM_CLOCK_CHANGED" />
                <action android:name="nodomain.freeyourgadget.gadgetbridge.ACTION_GENERIC_WEATHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROVIDER_CHANGED" />
                <data android:scheme="content" />
                <data android:host="com.android.calendar" />
                <data android:host="org.tasks" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/awidget_info" />
        </receiver>

        <receiver
            android:name=".media.MediaWidgetProvider"
            android:label="@string/media_widget_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/media_widget_info" />
        </receiver>

        <!-- Fold desk -->
        <receiver
            android:name=".desk.TodayWidgetProvider"
            android:label="@string/desk_today_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/desk_today_info" />
        </receiver>
        <receiver
            android:name=".desk.NotesWidgetProvider"
            android:label="@string/desk_notes_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/desk_notes_info" />
        </receiver>
        <service
            android:name=".desk.NotesWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />
        <receiver
            android:name=".desk.TasksWidgetProvider"
            android:label="@string/desk_tasks_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/desk_tasks_info" />
        </receiver>
        <receiver
            android:name=".desk.SearchWidgetProvider"
            android:label="@string/desk_search_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/desk_search_info" />
        </receiver>
        <receiver
            android:name=".media.SoftPlayerWidgetProvider"
            android:label="@string/media_soft_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/media_soft_info" />
        </receiver>

        <activity
            android:name=".notes.NoteEditorActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Lwidget.NoteEditor"
            android:windowSoftInputMode="adjustResize|stateVisible" />

        <!-- Needed only to see other apps' media sessions; notifications themselves are ignored -->
        <service
            android:name=".media.MediaListenerService"
            android:label="@string/media_widget_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".StepCounterService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="health" />

    </application>

</manifest>
