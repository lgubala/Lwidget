<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#111113" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- faint dot grid, inset so it stays inside the rounded corners -->
    <item android:drawable="@drawable/desk_dots_tile" android:top="4dp" android:bottom="4dp" android:left="4dp" android:right="4dp" />
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#242428" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</layer-list>
