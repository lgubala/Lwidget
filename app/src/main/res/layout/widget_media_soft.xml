<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/media_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <ImageView
                android:id="@+id/media_art"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:scaleType="centerCrop"
                android:src="@drawable/desk_art_placeholder"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:id="@+id/media_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/media_app_icon"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/ic_music_note"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/media_app"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:text="@string/media_label"
                        android:fontFamily="monospace"
            android:letterSpacing="0.13"
            android:textAllCaps="true"
            android:textColor="#55555A"
            android:textSize="8sp"
            android:includeFontPadding="false" />
                </LinearLayout>

                <TextView
                    android:id="@+id/media_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/media_nothing_playing"
                    android:textColor="#EDEDEE"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/media_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#8B8B90"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/media_controls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/media_prev"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_media_prev"
                    android:contentDescription="@string/media_previous" />

                <ImageView
                    android:id="@+id/media_play"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_media_play"
                    android:contentDescription="@string/media_play_pause" />

                <ImageView
                    android:id="@+id/media_next"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_media_next"
                    android:contentDescription="@string/media_next" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/media_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="8dp"
            android:minHeight="2dp"
            android:maxHeight="2dp"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/media_progress"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
