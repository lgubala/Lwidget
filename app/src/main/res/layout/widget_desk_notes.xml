<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notes_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/notes_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/notes_label"
            android:fontFamily="monospace"
            android:letterSpacing="0.13"
            android:textAllCaps="true"
            android:textColor="#55555A"
            android:textSize="8sp"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/notes_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:background="@drawable/desk_chip"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.13"
            android:text="@string/notes_add"
            android:textColor="#8B8B90"
            android:textSize="12sp"
            android:includeFontPadding="false" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp">

        <!-- Scrolls when there are more notes than fit -->
        <GridView
            android:id="@+id/notes_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="2"
            android:horizontalSpacing="6dp"
            android:verticalSpacing="6dp"
            android:stretchMode="columnWidth"
            android:listSelector="@android:color/transparent"
            android:scrollbars="none"
            android:fadingEdgeLength="16dp"
            android:requiresFadingEdge="vertical" />

        <TextView
            android:id="@+id/notes_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/desk_note"
            android:gravity="center"
            android:padding="12dp"
            android:text="@string/notes_empty"
            android:textColor="#8B8B90"
            android:textSize="12.5sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
